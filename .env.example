# Copia a .env.local y completa las integraciones que uses.

# Email (Resend — https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Wavys <contact@wavys-technologies.com>
EMAIL_REPLY_TO=contact@wavys-technologies.com

# Gmail / Google Workspace (si usas gws CLI)
# GOOGLE_APPLICATION_CREDENTIALS=

# Slack (futuro)
# SLACK_BOT_TOKEN=

# Notion / CRM (futuro)
# NOTION_API_KEY=

# Gemini — solo generación de imágenes (gemini-3.1-flash-lite-image)
GEMINI_API_KEY=

# Workana (Arnold S) — postulación diaria Playwright
# Export: npm run workana:export-session → pegar JSON en el secret del Cloud Agent env
# WORKANA_STORAGE_STATE_JSON=
# WORKANA_STORAGE_STATE_PATH=data/workana-storage-state.json
